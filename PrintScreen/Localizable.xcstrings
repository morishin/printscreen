    "Use ⌘⇧3 / ⌘⇧4 / ⌘⇧5, the macOS screenshot shortcuts, for PrintScreen instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende ⌘⇧3 / ⌘⇧4 / ⌘⇧5, die Bildschirmfoto-Kurzbefehle von macOS, stattdessen für PrintScreen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa ⌘⇧3 / ⌘⇧4 / ⌘⇧5, las funciones rápidas de captura de pantalla de macOS, para PrintScreen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez ⌘⇧3 / ⌘⇧4 / ⌘⇧5, les raccourcis de capture d'écran de macOS, pour PrintScreen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 標準のスクリーンショットのショートカット ⌘⇧3 / ⌘⇧4 / ⌘⇧5 を、PrintScreen で使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 스크린샷 단축키인 ⌘⇧3 / ⌘⇧4 / ⌘⇧5를 PrintScreen에서 대신 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改为在 PrintScreen 中使用 macOS 截屏快捷键 ⌘⇧3 / ⌘⇧4 / ⌘⇧5。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改為在 PrintScreen 中使用 macOS 截圖快速鍵 ⌘⇧3 / ⌘⇧4 / ⌘⇧5。"
          }
        }
      }
    },
