    "Allow PrintScreen in System Settings › Privacy & Security › Screen & System Audio Recording. You may need to restart the app afterward.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube PrintScreen unter Systemeinstellungen › Datenschutz & Sicherheit › Bildschirm- & Systemaudioaufnahme. Danach muss die App eventuell neu gestartet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite PrintScreen en Ajustes del Sistema › Privacidad y seguridad › Grabación de pantalla y audio del sistema. Puede que debas reiniciar la app después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez PrintScreen dans Réglages Système › Confidentialité et sécurité › Enregistrement de l'écran et de l'audio système. Vous devrez peut-être redémarrer l'app ensuite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 › プライバシーとセキュリティ › 画面収録とシステムオーディオ録音 で PrintScreen を許可してください。許可したあと、アプリの再起動が必要な場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 › 개인정보 보호 및 보안 › 화면 및 시스템 오디오 기록에서 PrintScreen을 허용하세요. 허용 후 앱을 다시 시작해야 할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置 › 隐私与安全性 › 录屏与系统录音”中允许 PrintScreen。之后可能需要重新启动 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「系統設定 › 隱私權與安全性 › 螢幕與系統錄音」中允許 PrintScreen。之後可能需要重新啟動 App。"
          }
        }
      }
    },
    "Allow this login item in System Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube dieses Anmeldeobjekt in den Systemeinstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite este ítem de inicio en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez cet élément d'ouverture dans Réglages Système."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定でログイン項目を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 이 로그인 항목을 허용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中允许此登录项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設定中允許此登入項目。"
          }
        }
      }
    },
